<?xml version="1.0"?>
<package>
  <name>gantry_detect</name>
  <version>0.0.1</version>
  <description>
    闸机口状态识别包: 订阅两路后向雷达点云(sensor_msgs/PointCloud2)与车辆定位(ivlocmsg),
    强度过滤高反目标 -> 聚类 -> 当车进入设定区域时判定闸机口 开/闭 状态并发布,
    同时在 rviz 中发布可视化点云/聚类框/状态标记方便调试。
  </description>

  <maintainer email="shenzb12@lzu.edu.cn">adam</maintainer>

  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>visualization_msgs</build_depend>
  <build_depend>message_generation</build_depend>
  <build_depend>ivlocmsg</build_depend>
  <build_depend>pcl_ros</build_depend>
  <build_depend>tf</build_depend>

  <run_depend>roscpp</run_depend>
  <run_depend>std_msgs</run_depend>
  <run_depend>sensor_msgs</run_depend>
  <run_depend>visualization_msgs</run_depend>
  <run_depend>ivlocmsg</run_depend>
  <run_depend>pcl_ros</run_depend>
  <run_depend>tf</run_depend>
  <run_depend>message_runtime</run_depend>
</package>
