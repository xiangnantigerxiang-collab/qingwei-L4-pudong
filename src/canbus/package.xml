<?xml version="1.0"?>
<package format="2">
  <name>canbus</name>
  <version>0.0.0</version>
  <description>The canbus driver</description>

  <maintainer email="zhangyu@todo.todo">lizhao</maintainer>

  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>
  <!-- 08-30 补既有缺口: 消息包缺 message_runtime; canbus_node 包含 robot/*.h 需构建依赖 robot(无环, robot 不依赖 canbus) -->
  <build_depend>message_runtime</build_depend>
  <build_depend>robot</build_depend>
  <build_depend>message_generation</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>socketcan_bridge</build_depend>
  <build_depend>socketcan_interface</build_depend>
  <build_depend>can_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>sensor_msgs</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>
  <build_export_depend>socketcan_bridge</build_export_depend>
  <build_export_depend>socketcan_interface</build_export_depend>
  <build_export_depend>can_msgs</build_export_depend>
  <build_export_depend>geometry_msgs</build_export_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>robot</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>socketcan_bridge</exec_depend>
  <exec_depend>socketcan_interface</exec_depend>
  <exec_depend>can_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

</package>
