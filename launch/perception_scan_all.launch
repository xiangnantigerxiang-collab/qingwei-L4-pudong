<launch>
  <node pkg="lidar_perception" type="lidar_perception_scan_all" name="lidar_perception_scan_all" output="screen">
    <param name="frame_id" type="string" value="vcs" />
    <param name="read_scan_main_topic" type="string" value="/lidar_pointcloud_rear_left" />
    <!-- <param name="read_scan_other1_topic" type="string" value="/lidar_pointcloud_rear_right" /> -->
    <param name="bbox_pub_topic" type="string" value="/scan_bbox_result" />
    <param name="perception_pub_topic" type="string" value="/scan_perception_result" />
    <param name="min_x" type="double" value="2.5" />  
     <!-- <param name="min_x" type="double" value="-5" />   -->
    <param name="max_x" type="double" value="8.0" />
    <param name="min_y" type="double" value="-1" />
    <param name="max_y" type="double" value="1" />
    <param name="min_z" type="double" value="-1.4" />
    <param name="max_z" type="double" value="1.4" />
    <param name="radius" type="double" value="0.4" />
    <param name="road_polygon_path" type="string" value="/home/qwrf/mogu-master/src/data/road_area" />
    <param name="use_hdmap" type="bool" value="true" />
    <param name="sub_pose" type="string" value="/localization" />
    <rosparam param="dis_level" >[0, 0.8, 2, 4, 6, 8]</rosparam>
  </node>
</launch>