<launch>
    <node pkg="socketcan_bridge" type="socketcan_bridge_node" name="socketcan_bridge_node">
        <param name="can_device" value="can0"/>
        <remap from="sent_messages" to="can_send"/>
        <remap from="received_messages" to="can_recv"/>
    </node>

    <node name="canbus"  pkg="canbus"  type="aeb_can_node" output="screen"/>
</launch>
